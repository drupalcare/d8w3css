{#
/**
 * @file
 * Theme override to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template in this directory.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation. Will usually be
 *   "/" unless you have installed Drupal in a sub-directory.
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 * - is_admin: A flag indicating if the user has permission to access
 *   administration pages.
 *
 * Site identity:
 * - front_page: The URL of the front page. Use this instead of base_path when
 *   linking to the front page. This includes the language domain or prefix.
 *
 * Page content (in order of occurrence in the default page.html.twig):
 * - node: Fully loaded node, if there is an automatically-loaded node
 *   associated with the page and the node ID is the second argument in the
 *   page's path (e.g. node/12345 and node/12345/revisions, but not
 *   comment/reply/12345).
 *
 * Regions:
 * - page.primary_menu_vertical: Items for the Side Navigation region.
 * - page.header: Items for the header region.
 * - page.primary_menu: Items for the Navigation region.
 * - page.welcome_text: Items for welcome message.
 * - page.top_first: Items for top first region.
 * - page.top_second: Items for top second region.
 * - page.top_third: Items for top third region.
 * - page.highlighted: Items for the highlighted region.
 * - page.page_title: Used by Current page Title.
 * - page.breadcrumb: Item for the Breadcrumb region.
 * - page.content: The main content of the current page.
 * - page.sidebar_first: Items for the first sidebar.
 * - page.sidebar_second: Items for the second sidebar.
 * - page.bottom_first: Items for the bottom first region.
 * - page.bottom_second: Items for the bottom Second region.
 * - page.bottom_third: Items for the bottom third region.
 * - page.bottom_forth: Items for the bottom forth region.
 * - page.footer_first: Items for the footer first region.
 * - page.footer_second: Items for the footer Second region.
 * - page.footer_third: Items for the footer third region.
 * - page.footer_menu: Items for the footer bottom region.
 * - page.auto_hidden_block: Hide items in this region.
 *
 * Twig blocks for sub-themes: a sub-theme's page.html.twig can extend this
 * file with {% extends '@drupal8_w3css_theme/layout/page.html.twig' %} and
 * override only the blocks it changes. Region visibility (is_front) sits
 * outside the region blocks, so block('name') reuses the markup elsewhere.
 * - w3css_page: everything below (vertical nav and page wrapper).
 * - w3css_nav_vertical: the side navigation.
 * - w3css_chrome: header and horizontal navigation, with nested blocks
 *   w3css_header and w3css_nav_horizontal.
 * - w3css_welcome_text, w3css_highlighted, w3css_top, w3css_page_title.
 * - w3css_main: breadcrumb and main container, with nested blocks
 *   w3css_breadcrumb, w3css_sidebar_first, w3css_content and
 *   w3css_sidebar_second.
 * - w3css_page_bottom: bottom regions and footer, with nested blocks
 *   w3css_bottom and w3css_footer; w3css_footer nests w3css_footer_regions,
 *   w3css_footer_menu (which nests w3css_social_media) and w3css_copyright.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{% block w3css_page %}
{% block w3css_nav_vertical %}
  {# The menu blocks print their own nav landmark, so these wrappers are not one. #}
  {% if page.primary_menu_vertical %}
  <!-- Start: Main Navigation - Vertical -->
<div id="w3css-main-nav-vertical" class="w3css-main-nav--vertical w3css-main-nav w3-sidebar w3-bar-block w3-animate-left w3-theme {{ color_primary_menu }}">
  <div id="w3css-main-nav-inner-vertical" class="w3css-main-nav__inner--vertical">
    <button type="button" id="w3css-main-nav-close" class="w3css-main-nav__close w3-button w3-bar-block w3-large w3-theme {{ color_primary_menu }}" aria-label="{{ 'Close side menu'|t }}">
      <svg aria-hidden="true" role="img" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="203 -757 554 554" fill="currentColor"><path d="m249-207-42-42 231-231-231-231 42-42 231 231 231-231 42 42-231 231 231 231-42 42-231-231-231 231Z"/></svg>
    </button>
    {{ page.primary_menu_vertical }}
  </div>
</div>
<!-- End: Main Navigation - Vertical -->
{% endif %}
{% endblock w3css_nav_vertical %}
<!-- Start: Page Wrapper -->
<div class="w3css-page-wrapper w3-col w3-clear w3-animate-opacity w3-text-theme {{ color_page_wrapper }}">

  {% block w3css_chrome %}
  {% block w3css_header %}
  {% if page.header or page.primary_menu_vertical %}
  <!-- Start: Header -->
  <header id="w3css-header" class="w3-col w3-clear w3-theme-l4 {{ sitename_animation }} {{ color_header }}" aria-label="{{ 'Site header'|t }}">
    <div id="w3css-header-inner" class="w3-container w3css-header__inner {{ website_width }}">
      {% if page.primary_menu_vertical %}
      <button type="button" id="w3css-main-nav-open" class="w3css-main-nav__open w3-opacity w3-hover-opacity-off w3-left w3-button w3-left-align w3-large w3-theme {{ color_primary_menu }}" aria-label="{{ 'Open side menu'|t }}" aria-controls="w3css-main-nav-vertical" aria-expanded="false">
        <svg aria-hidden="true" role="img" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="116 -724 728 488" fill="currentColor"><path d="M120-240v-60h720v60H120Zm0-210v-60h720v60H120Zm0-210v-60h720v60H120Z"/></svg>
      </button>
      {% endif %}
      {% if page.header %}
      {{ page.header }}
      {% endif %}
    </div>
  </header>
  <!-- End: Header -->
  {% endif %}
  {% endblock w3css_header %}

  {% block w3css_nav_horizontal %}
  {% if page.primary_menu %}
  <!-- Start: Main Navigation - Horizontal -->
  <div id="w3css-main-nav-horizontal" class="w3css-main-nav--horizontal w3-col w3-clear w3css-main-nav w3-theme {{ color_primary_menu }}">
    <div id="w3css-main-nav-inner-horizontal" class="w3-row w3css-main-nav__inner--horizontal {{ website_width }}">
      <div class="w3css-mobile-nav__toggle w3-hide-large w3-button w3-block w3-right-align w3-large w3-theme {{ color_primary_menu }}">
        <svg aria-hidden="true" role="img" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="116 -724 728 488" fill="currentColor"><path d="M120-240v-60h720v60H120Zm0-210v-60h720v60H120Zm0-210v-60h720v60H120Z"/></svg>
      </div>
      {{ page.primary_menu }}
    </div>
  </div>
  <!-- End: Main Navigation - Horizontal -->
  {% endif %}
  {% endblock w3css_nav_horizontal %}
  {% endblock w3css_chrome %}

  {% block w3css_welcome_text %}
  {% if is_front and page.welcome_text %}
  <!-- Start: Welcome Text -->
  <div id="w3css-welcome-text" class="w3-col w3-clear w3-theme-l5 {{ color_welcome_text }}">
    <div id="w3css-welcome-text-inner" class="w3-row w3css-welcome-text__inner {{ website_width }}">
      {{ page.welcome_text }}
    </div>
  </div>
  <!-- End: Welcome Text -->
  {% endif %}
  {% endblock w3css_welcome_text %}

  {% block w3css_highlighted %}
  {% if page.highlighted %}
  <!-- Start: Highlighted -->
  <div id="w3css-highlighted" class="w3-col w3-clear w3-theme-l2 {{ color_highlighted}}">
    <div id="w3css-highlighted-inner" class="w3css-fade w3-row w3css-highlighted__inner {{ website_width }}">
      {{ page.highlighted }}
    </div>
  </div>
  <!-- End: Highlighted -->
  {% endif %}
  {% endblock w3css_highlighted %}

  {% if is_front %}
    {% block w3css_top %}
    {% if page.top_first or page.top_second or page.top_third %}
  <!-- Start: Top Container -->
  <div id="w3css-top-region" class="w3-col w3-clear w3-theme-l4 {{ color_top_container }}">
    <div id="w3css-top-region-inner" class="w3-row-padding w3css-top-region__inner {{ website_width }}">
      {% if page.top_first %}
      <!-- Start: Top container first region -->
      <div class="{{ top_w3css }} w3css-top-box {{ top_region ? 'top-region' }} w3css-first-top">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l5 {{ color_top_first}}">
         {{ page.top_first }}
        </div>
      </div>
      <!-- End: Top Container First -->
      {% endif %}
      {% if page.top_second %}
      <!-- Start: Top Container Second  -->
      <div class="{{ top_w3css }} w3css-top-box {{ top_region ? 'top-region' }} w3css-second-top">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l5 {{ color_top_second }}">
         {{ page.top_second }}
        </div>
      </div>
      <!-- End: Top Container Second -->
      {% endif %}
      {% if page.top_third %}
      <!-- Start: Top Container Third -->
      <div class="{{ top_w3css }} w3css-top-box {{ top_region ? 'top-region' }} w3css-third-top">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l5 {{ color_top_third }}">
          {{ page.top_third }}
        </div>
      </div>
      <!-- End: Top Container Third -->
      {% endif %}
    </div>
  </div>
  <!-- End: Top container -->
    {% endif %}
    {% endblock w3css_top %}
  {% endif %}

  {% block w3css_page_title %}
  {% if page.page_title and not is_front %}
  <!-- Start: Page Title -->
  <div id="w3css-page-title" class="w3-col w3-clear w3-theme-d5 {{ pagetitle_animation }} {{ color_page_title }}">
    <div id="w3css-page-title-inner" class="w3css-fade w3-row w3css-page-title__inner {{ website_width }}">
      {{ page.page_title }}
    </div>
  </div>
  <!-- End: Page Title -->
  {% endif %}
  {% endblock w3css_page_title %}

  {% block w3css_main %}
  <!-- Start: Main -->
  <div id="w3css-main-region" class="w3-col w3-clear w3-theme-l5 {{ color_main }}">
    <div id="w3css-main-region-inner" class="w3-row w3css-main-region__inner {{ website_width }}">
      {% block w3css_breadcrumb %}
      {% if page.breadcrumb|render|striptags|trim %}
      <!-- Breadcrumb -->
      <div class="w3-row w3-breadcrumb {{ color_breadcrumb }}">
        {{ page.breadcrumb }}
      </div>
      <!-- End: Breadcrumb -->
      {% endif %}
      {% endblock w3css_breadcrumb %}
      <!-- Start Main Container  -->
      <div class="w3-col w3-clear w3-row-padding">
        {% block w3css_sidebar_first %}
        {% if page.sidebar_first %}
        <!-- Start Left SideBar -->
        <aside class="{{ sidebarfirst }} w3css-main-box {{ main_region ? 'main-region' }} w3css-first-sidebar" aria-label="{{ 'First sidebar'|t }}">
          <div class="w3css-fade w3-sidebar-first w3-mobile {{ color_sidebar_first }}">
            {{ page.sidebar_first }}
          </div>
        </aside>
        <!-- End: Left SideBar -->
        {% endif %}
        {% endblock w3css_sidebar_first %}
        {% block w3css_content %}
        {% if page.content %}
        <!-- Start: Main Content -->
        <main id="main-content" tabindex="-1" class="{{ content_w3css }} w3css-main-box {{ main_region ? 'main-region' }} w3css-content-region">
          <div class="w3css-fade w3-mobile {{ color_content }}">
            {{ page.content }}
          </div>
        </main>
        <!-- End: Main Content -->
        {% endif %}
        {% endblock w3css_content %}
        {% block w3css_sidebar_second %}
        {% if page.sidebar_second %}
        <!-- Start: Right SideBar -->
        <aside class="{{ sidebarsecond }} w3css-main-box {{ main_region ? 'main-region' }} w3css-second-sidebar" aria-label="{{ 'Second sidebar'|t }}">
          <div class="w3css-fade w3-sidebar-second w3-mobile {{ color_sidebar_second }}">
            {{ page.sidebar_second }}
          </div>
        </aside>
        <!-- End: Right SideBar -->
        {% endif %}
        {% endblock w3css_sidebar_second %}
      </div>
      <!-- End: Main Container  -->
    </div>
  </div>
  <!-- End: Main -->
  {% endblock w3css_main %}

  {% block w3css_page_bottom %}
  {% if is_front %}
    {% block w3css_bottom %}
    {% if page.bottom_first or page.bottom_second or page.bottom_third or page.bottom_forth %}
      <!-- Start: Bottom -->
  <div id="w3css-bottom-region" class="w3-col w3-clear w3-theme-l2 {{ color_bottom_container }}">
    <div id="w3css-bottom-region-inner" class="w3-row-padding w3css-bottom-region__inner {{ website_width }}">
      {% if page.bottom_first %}
      <!-- Start: Bottom First -->
      <div class="{{ bottom_w3css }} w3css-bottom-box {{ bottom_region ? 'bottom-region' }} w3css-first-bottom">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_bottom_first }}">
          {{ page.bottom_first }}
        </div>
      </div>
      <!-- End: Bottom First -->
      {% endif %}
      {% if page.bottom_second %}
      <!-- Start: Bottom Second -->
      <div class="{{ bottom_w3css }} w3css-bottom-box {{ bottom_region ? 'bottom-region' }} w3css-second-bottom">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_bottom_second }}">
          {{ page.bottom_second }}
        </div>
      </div>
      <!-- End: Bottom Second -->
      {% endif %}
      {% if page.bottom_third %}
      <!-- Start: Bottom Third  -->
      <div class="{{ bottom_w3css }} w3css-bottom-box {{ bottom_region ? 'bottom-region' }} w3css-third-bottom">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_bottom_third }}">
          {{ page.bottom_third }}
        </div>
      </div>
      <!-- End: Bottom Third -->
      {% endif %}
      {% if page.bottom_forth %}
      <!-- Start: Bottom Forth  -->
      <div class="{{ bottom_w3css }} w3css-bottom-box {{ bottom_region ? 'bottom-region' }} w3css-forth-bottom">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_bottom_forth }}">
          {{ page.bottom_forth }}
        </div>
      </div>
      <!-- End: Bottom Forth -->
      {% endif %}
    </div>
  </div>
  <!-- End: Bottom -->
    {% endif %}
    {% endblock w3css_bottom %}
  {% endif %}

  {% block w3css_footer %}
  {% if page.footer_first or page.footer_second or page.footer_third or page.footer_menu or show_social_icon or copyright_text or show_credit_link %}
  <footer class="w3css-page-footer w3-col w3-clear">
  {% block w3css_footer_regions %}
  {% if page.footer_first or page.footer_second or page.footer_third %}
  <!-- start: Footer -->
  <div id="w3css-footer-region" class="w3-col w3-clear w3-theme-d3 {{ color_footer_container }}">
    <div id="w3css-footer-region-inner" class="w3-row-padding w3css-footer-region__inner {{ website_width }}">

      {% if page.footer_first %}
      <!-- Start: Footer First  -->
      <div class="{{ footer_w3css }} w3css-footer-box {{ footer_region ? 'footer-region' }} w3css-first-footer">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_footer_first }}">
          {{ page.footer_first }}
        </div>
      </div>
      <!-- End: Footer First -->
      {% endif %}
      {% if page.footer_second %}
      <!-- Start: Footer Second Region -->
      <div class="{{ footer_w3css }} w3css-footer-box {{ footer_region ? 'footer-region' }} w3css-second-footer">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l5 {{ color_footer_second }}">
          {{ page.footer_second }}
        </div>
      </div>
    <!-- End: Footer Second -->
      {% endif %}
      {% if page.footer_third %}
      <!-- Start: Footer Third -->
      <div class="{{ footer_w3css }} w3css-footer-box {{ footer_region ? 'footer-region' }} w3css-third-footer">
        <div class="w3css-fade w3-mobile {{ border_animation ? 'w3css-animate-border' }} w3-theme-l4 {{ color_footer_third }}">
          {{ page.footer_third }}
        </div>
      </div>
      <!-- End: Footer Third -->
      {% endif %}
    </div>
  </div>
  <!-- End: Footer -->
  {% endif %}
  {% endblock w3css_footer_regions %}

  {% block w3css_footer_menu %}
  {% if page.footer_menu or show_social_icon %}
    <!-- Start: Footer Menu -->
  <div id="w3css-footer-menu" class="w3css-footer-menu w3-col w3-clear w3-theme-d4 {{ color_footer_menu }}">
    <div id="w3css-footer-menu-inner" class="w3-row w3css-footer-menu__inner {{ website_width }}">
      {% block w3css_social_media %}
      {% if show_social_icon %}
        <!-- Start: Social Media -->
      <div class="w3css-fade w3-center w3-container w3-mobile w3css-social-media">
        <ul class="w3css-social-media__list">
        {% set w3css_social_links = {
          'facebook': {'url': facebook_url, 'title': 'Facebook', 'label': 'Facebook (opens in a new tab)'|t},
          'twitter': {'url': twitter_url, 'title': 'X', 'label': 'X (opens in a new tab)'|t},
          'pinterest': {'url': pinterest_url, 'title': 'Pinterest', 'label': 'Pinterest (opens in a new tab)'|t},
          'linkedin': {'url': linkedin_url, 'title': 'LinkedIn', 'label': 'LinkedIn (opens in a new tab)'|t},
          'instagram': {'url': instagram_url, 'title': 'Instagram', 'label': 'Instagram (opens in a new tab)'|t},
          'youtube': {'url': youtube_url, 'title': 'YouTube', 'label': 'YouTube (opens in a new tab)'|t},
          'drupal': {'url': drupal_url, 'title': 'Drupal', 'label': 'Drupal (opens in a new tab)'|t},
          'mastodon': {'url': mastodon_url, 'title': 'Mastodon', 'label': 'Mastodon (opens in a new tab)'|t},
          'rss': {'url': rss_url, 'title': 'RSS Feed', 'label': 'RSS Feed (opens in a new tab)'|t},
        } %}
        {% for key, social in w3css_social_links %}
          {% if social.url %}
            <li class="w3css-social-media__item">
              <a href="{{ social.url }}" title="{{ social.title }}" class="w3css-social-media__link w3css-social-media__link--{{ key }}" target="_blank" rel="noopener noreferrer">
                <span class="w3css-social-media__icon" aria-hidden="true">
                  {% include '@drupal8_w3css_theme/partials/svg/_svg-' ~ key ~ '.html.twig' %}
                </span>
                <span class="visually-hidden">{{ social.label }}</span>
              </a>
            </li>
          {% endif %}
        {% endfor %}
        </ul>
      </div>
      <!-- End: Social Media -->
      {% endif %}
      {% endblock w3css_social_media %}
      <!-- Start: Bottom Menu -->
      {% if page.footer_menu %}
      <div class="w3css-fade w3-container w3-center w3-mobile">
        {{ page.footer_menu }}
      </div>
      <!-- End: Bottom Menu -->
      {% endif %}
    </div>
  </div>
  <!-- End: Footer Menu -->
  {% endif %}
  {% endblock w3css_footer_menu %}

  {% block w3css_copyright %}
  {% if copyright_text or show_credit_link %}
  <!-- Start: Copyright -->
  <div id="w3css-copyright" class="w3-col w3-clear w3-theme-d5 {{ color_copyright }}">
    <div id="w3css-copyright-inner" class="w3-row w3css-copyright__inner {{ website_width }}">
      {% if copyright_text %}
      <!-- Start: Copyright -->
      <div class="w3-half w3-container w3-mobile">
        <p class="w3-section w3-left-align">
        {# The page preprocess replaces %year% and caps the cache at year end. #}
        {{ copyright_text }}
        </p>
      </div>
      <!-- End: Copyright -->
      {% endif %}
      {% if show_credit_link %}
      <!-- Start: Credit Link -->
      <div class="w3-half w3-container w3-mobile">
        <p class="w3-section w3-right-align">{{ 'Developed & Designed by'|t }} <a href="https://www.alaahaddad.com" title="Alaa Haddad" target="_blank" rel="noopener">Alaa Haddad</a></p>
      </div>
      <!-- End: Credit Link -->
      {% endif %}
    </div>
  </div>
  <!-- End: Copyright -->
  {% endif %}
  {% endblock w3css_copyright %}
  </footer>
  {% endif %}
  {% endblock w3css_footer %}
  {% endblock w3css_page_bottom %}
</div>
<!-- End: Page Wrapper -->
{% endblock w3css_page %}
