{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}

{% macro svg_icon(icon_value) %}
  <svg aria-hidden="true" role="img" xmlns="http://www.w3.org/2000/svg" width="14" height="8" viewBox="5 8 14 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="bevel"><path d="{{ icon_value }}"/></svg>
{% endmacro %}

<div class="w3css-vertical-nav">
{% import _self as menus %}
{#
  We call a macro which calls itself to render the full tree.
  @see http://twig.sensiolabs.org/doc/tags/macro.html
#}
{{ menus.menu_links(items, attributes, 0, menu_name) }}
{% macro menu_links(items, attributes, menu_level, menu_name) %}
  {% import _self as menus %}
  {%
    set menu_classes = [
      'w3css-menu__list w3css-menu__list--menu-' ~ menu_name|clean_class,
    ]
  %}
  {%
    set submenu_classes = [
      'w3css-menu__submenu w3css-menu__submenu--menu-' ~ menu_name|clean_class,
    ]
  %}
  {% if items %}
  {% if menu_level == 0 %}
  <ul {{ attributes.addClass(menu_classes).removeAttribute('region') }}>
    {% else %}
  <ul {{ attributes.removeClass(menu_classes).addClass(submenu_classes) }}>
  {% endif %}

    {% for item in items %}

      {%
        set item_classes = [
          'w3css-menu__item w3css-menu__item--menu-' ~ menu_name|clean_class,
          item.is_expanded? 'w3css-menu__item--expanded',
          item.is_expanded and menu_level == 0 ? 'w3css-menu__item--parent',
          item.in_active_trail ? 'active',
        ]
      %}

      {# Set additional attributes if they exist #}
      {% set additional_classes = item.url.getOption('attributes').class|default('') %}
      {% set class_list = additional_classes is iterable ? additional_classes|join(' ') : additional_classes %}

     {% if menu_level == 0 and item.is_expanded %}
        <li{{ item.attributes.addClass(item_classes) }}>
        {% import _self as macros %}
        {# if link is clickable #}
        {# Placeholder routes toggle a submenu; every other URL (paths, external,
           #anchor, mailto:, tel:) is a real link. #}
        {% if not (item.url.isRouted and item.url.routeName in ['<nolink>', '<button>', '<none>']) %}
        {% set clickable_classes = ['w3-button w3css-menu__link--enabled w3css-menu__toggle-parent'] %}
        {% if class_list %}
            {% set clickable_classes = clickable_classes|merge([class_list]) %}
        {% endif %}
          {% set link_target = item.url.getOption('attributes').target|default('') %}
          {% set link_rel = item.url.getOption('attributes').rel|default('') %}
          {% set link_rel = link_rel is iterable ? link_rel|join(' ') : link_rel %}
          {% if link_target == '_blank' and 'noopener' not in link_rel %}
            {% set link_rel = (link_rel ~ ' noopener')|trim %}
          {% endif %}
          <a href="{{ item.url }}" class="{{ clickable_classes|join(' ') }}"
            {%- if item.url.getOption('attributes').title %} title="{{ item.url.getOption('attributes').title }}" {% endif -%}
            {%- if link_target %} target="{{ link_target }}" {% endif -%}
            {%- if link_rel %} rel="{{ link_rel }}" {% endif -%}>{{ item.title }}
            {%- if link_target == '_blank' %}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>{% endif %}
          </a>
          <span class="w3css-menu__arrow w3-hover-over w3css-menu__arrow-toggle">
            {{ macros.svg_icon('M6 9l6 6 6-6') }}{# down arrow #}
          </span>
        {# if link is not clickable #}
        {% else %}
        {% set non_clickable_classes = ['w3-button w3css-menu__link--disabled w3css-menu__link-toggle-vertical w3css-menu__toggle-parent'] %}
        {% if class_list %}
            {% set non_clickable_classes = non_clickable_classes|merge([class_list]) %}
        {% endif %}
          <button type="button" class="{{ non_clickable_classes|join(' ') }}"
            {%- if item.url.getOption('attributes').title %} title="{{ item.url.getOption('attributes').title }}" {% endif -%}>{{ item.title }}
          <span class="w3css-menu__arrow w3-hover-over">
            {{ macros.svg_icon('M6 9l6 6 6-6') }}{# down arrow #}
          </span>
        </button>
        {% endif %}

      {% elseif menu_level != 0 and item.is_expanded %}
      <li{{ item.attributes.addClass(item_classes) }}>
      {% import _self as macros %}
         {# if link is clickable #}
        {# Placeholder routes toggle a submenu; every other URL (paths, external,
           #anchor, mailto:, tel:) is a real link. #}
        {% if not (item.url.isRouted and item.url.routeName in ['<nolink>', '<button>', '<none>']) %}
        {% set clickable_classes = ['w3-button w3css-menu__link--enabled w3css-menu__toggle-child'] %}
        {% if class_list %}
            {% set clickable_classes = clickable_classes|merge([class_list]) %}
        {% endif %}
          {% set link_target = item.url.getOption('attributes').target|default('') %}
          {% set link_rel = item.url.getOption('attributes').rel|default('') %}
          {% set link_rel = link_rel is iterable ? link_rel|join(' ') : link_rel %}
          {% if link_target == '_blank' and 'noopener' not in link_rel %}
            {% set link_rel = (link_rel ~ ' noopener')|trim %}
          {% endif %}
          <a href="{{ item.url }}" class="{{ clickable_classes|join(' ') }}"
            {%- if item.url.getOption('attributes').title %} title="{{ item.url.getOption('attributes').title }}" {% endif -%}
            {%- if link_target %} target="{{ link_target }}" {% endif -%}
            {%- if link_rel %} rel="{{ link_rel }}" {% endif -%}>{{ item.title }}
            {%- if link_target == '_blank' %}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>{% endif %}
          </a>
          <span class="w3css-menu__arrow w3-hover-over w3css-menu__arrow-toggle">
            {{ macros.svg_icon('M6 9l6 6 6-6') }}{# down arrow #}
          </span>
        {# if link is not clickable #}
        {% else %}
        {% set non_clickable_classes = ['w3-button w3css-menu__link--disabled w3css-menu__link-toggle-vertical w3css-menu__toggle-child'] %}
        {% if class_list %}
            {% set non_clickable_classes = non_clickable_classes|merge([class_list]) %}
        {% endif %}
          <button type="button" class="{{ non_clickable_classes|join(' ') }}"
            {%- if item.url.getOption('attributes').title %} title="{{ item.url.getOption('attributes').title }}" {% endif -%}>{{ item.title }}
            <span class="w3css-menu__arrow w3-hover-over">
            {{ macros.svg_icon('M6 9l6 6 6-6') }}{# down arrow #}
            </span>
          </button>
        {% endif %}

      {% else %} {# if it is not expanded #}
      {%
        set link_classes = [
          'w3-button w3css-menu__link w3css-menu__link--menu-' ~ menu_name|clean_class,
        ]
      %}
      <li{{ item.attributes.addClass(item_classes) }}>
        {# A new-window link says so to screen readers, like the expanded links above. #}
        {% set leaf_text = item.title %}
        {% if item.url.getOption('attributes').target|default('') == '_blank' %}
          {% set leaf_text = {
            '#type': 'inline_template',
            '#template': '{{ title }}<span class="visually-hidden"> {{ "(opens in a new tab)"|t }}</span>',
            '#context': {'title': item.title},
          } %}
        {% endif %}
        {{
          link(
            leaf_text,
            item.url,
            item.attributes.removeClass(item_classes).addClass(link_classes)
          )
        }}
      {% endif %}
      {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1, menu_name) }}
      {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
</div>
